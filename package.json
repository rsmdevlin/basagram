{
  "name": "basagram",
  "version": "0.1.1",
  "description": "Premium modern messenger",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "npm install --legacy-peer-deps && cd apps/api && npm run build && cd ../../apps/web && npm run build",
    "start": "node start.js",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "turbo": "^1.10.16",
    "eslint": "^8.54.0",
    "@typescript-eslint/eslint-plugin": "^6.13.2",
    "@typescript-eslint/parser": "^6.13.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
